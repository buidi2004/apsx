thành màu trắng theo yêu cầu */\r\n            font-weight: 700;\r\n        }\r\n        /* Hình ảnh */\r\n        .image-container {\r\n            margin: 30px 0;\r\n            text-align: center;\r\n        }\r\n        .image-container img {\r\n            max-width: 100%;\r\n            height: auto;\r\n            border-radius: 8px;\r\n            box-shadow: 0 0 15px rgba(217, 0, 27, 0.3);\r\n        }\r\n        /* Danh sách */\r\n        ul {\r\n            padding-left: 20px;\r\n            list-style-type: none; /* Bỏ chấm đen mặc định */\r\n        }\r\n        ul li:before {\r\n            content: \"✦\"; /* Dùng ký hiệu thay thế */\r\n            color: #D9001B;\r\n            display: inline-block; \r\n            width: 1em;\r\n            margin-left: -1em;\r\n        }\r\n        ul li {\r\n            margin-bottom: 10px;\r\n        }\r\n    \r\n         /* Call to Action */\r\n        .cta {\r\n            text-align: center;\r\n            margin-top: 60px; /* Tăng margin để tách khỏi bảng */\r\n            padding: 10px; /* Giảm padding vì không còn nền */\r\n            font-size: 1.1em; /* Đã giảm kích thước chữ cơ bản */\r\n            font-weight: 700;\r\n            color: #FF405B; /* Thêm màu đỏ ROG cho toàn bộ CTA */\r\n        }\r\n        .cta p {\r\n            margin: 5px 0;\r\n        }\r\n        .cta a {\r\n            color: #FFFFFF;\r\n            text-decoration: none;\r\n            /* Nút CTA mới */\r\n            background-color: #D9001B; \r\n            padding: 10px 25px;\r\n            border-radius: 5px;\r\n            display: inline-block;\r\n            margin-top: 15px;\r\n            transition: background-color 0.3s;\r\n        }\r\n        .cta a:hover {\r\n            background-color: #FF405B;\r\n        }\r\n        /* Bảng Thông số kỹ thuật (Spec Table) */\r\n        .spec-table {\r\n            width: 100%;\r\n            margin: 40px 0;\r\n            border-collapse: collapse;\r\n            font-size: 0