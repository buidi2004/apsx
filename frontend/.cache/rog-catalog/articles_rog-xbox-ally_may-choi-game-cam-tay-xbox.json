         flex: 1; \r\n            min-width: 300px; \r\n            max-width: 48%; \r\n            text-align: center;\r\n            /* Đảm bảo khung chứa có tỷ lệ 1:1 */\r\n            position: relative;\r\n            padding-bottom: 48%; /* 100% của chiều rộng cha để tạo tỷ lệ 1:1 (khi flex:1 max-width:48% thì 48% là phù hợp) */\r\n            height: 0;\r\n            overflow: hidden; /* Cắt phần tràn ra */\r\n        }\r\n        .dual-image-container .image-item img {\r\n            position: absolute;\r\n            top: 0;\r\n            left: 0;\r\n            width: 100%;\r\n            height: 100%;\r\n            object-fit: cover; /* Đảm bảo hình ảnh lấp đầy khung mà không bị méo */\r\n            border-radius: 8px;\r\n            box-shadow: 0 0 15px rgba(217, 0, 27, 0.3);\r\n        }\r\n        /* Danh sách */\r\n        ul {\r\n            padding-left: 20px;\r\n            list-style-type: none; \r\n        }\r\n        ul li:before {\r\n            content: \"✦\"; /* Dùng ký hiệu thay thế */\r\n            color: #D9001B;\r\n            display: inline-block; \r\n            width: 1em;\r\n            margin-left: -1em;\r\n        }\r\n        ul li {\r\n            margin-bottom: 10px;\r\n        }\r\n        /* Call to Action */\r\n        .cta {\r\n            text-align: center;\r\n            margin-top: 60px; \r\n            padding: 10px; \r\n            font-size: 1.1em; \r\n            font-weight: 700;\r\n            color: #FF405B; \r\n        }\r\n        .cta p {\r\n            margin: 5px 0;\r\n        }\r\n        .cta a {\r\n            color: #FFFFFF;\r\n            text-decoration: none;\r\n            background-color: #D9001B; \r\n            padding: 10px 25px;\r\n            border-radius: 5px;\r\n            display: inline-block;\r\n            margin-top: 15px;\r\n            transition: background-color 0.3s;\r\n        }\r\n        .cta a:hover {\r\n            background-color: #FF405B;\r\n        }\r\n        /* Bảng Thông số kỹ thuật (Spec Table) */\r\n        .spec-table {\r\n            width: 100%;\r\n            margin: 40px 0;\r\n            border-collapse: collapse;\r\n            font-size: 0.95em;\r\n            box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\r\n        }\r\n        .spec-table caption {\r\n            text-align: left;\r\n            font-size: 1.5em;\r\n            font-weight: 700;\r\n            color: #FF405B;\r\n            margin-bottom: 15px;\r\n            text-transform: uppercase;\r\n        }\r\n        .spec-table th, .spec-table td {\r\n            padding: 12px 15px;\r\n            text-align: left;\r\n            border-bottom: 1px solid #333; /* Đường kẻ mỏng */\r\n        }\r\n        .spec-table th {\r\n            background-color: #222; /* Nền hàng tiêu đề */\r\n            color: #D9001B;\r\n            width: 30%; \r\n            font-weight: 700;\r\n        }\r\n        .spec-table td {\r\n            background-color: #1A1A1A; /* Nền hàng dữ liệu */\r\n        }\r\n        .spec-table tr:hover td {\r\n            background-color: #252525; /* Hiệu ứng hover nhẹ */\r\n        }\r\n        .spec-table tr:last-child th, .spec-table tr:last-child td {\r\n            border-bottom: none;\r\n        }\r\n</style>\r\n<div class=\"container\">\r\n<p><i>Thế hệ m&aacute;y chơi game cầm tay mới trang AMD Ryzen Z2 Series do ROG v&agrave; Xbox hợp t&aacute;c ph&aacute;t triển ch&iacute;nh thức đổ bộ thị trường Việt Nam.</i></p>\r\n\r\n<div class=\"image-container\"><!-- Placeholder image for the series, emphasizing portability and power --><a href=\"https://vn.store.asus.com/rog-xbox-ally?utm_source=rog-local&amp;utm_medium=blog&amp;utm_campaign=25q4_rog_vn&amp;utm_content=backlink_kw_rogxboxallyseries\" target=\"_blank\"><img  accesskey=\"38921\" alt=\"ROG Xbox Ally 2025\" src=\"https://rog.asus.com/media/1761933603943.jpg\" /></a></div>\r\n\r\n<div class=\"content-block intro\">\r\n<p style=\"font-size: 1.1em;\"><a href=\"https://vn.store.asus.com/rog-xbox-ally?utm_source=rog-local&amp;utm_medium=blog&amp;utm_campaign=25q4_rog_vn&amp;utm_content=backlink_kw_rogxboxallyseries\" target=\"_blank\">ROG Xbox Ally Series</a> (bao gồm <a href=\"/vn/gaming-handhelds/rog-ally/rog-xbox-ally-2025/?utm_source=asus-local&amp;utm_medium=blog&amp;utm_campaign=25q4_rog_vn&amp;utm_content=backlink_kw_rogxboxally\" target=\"_blank\">ROG Xbox Ally</a> v&agrave; <a href=\"/vn/gaming-handhelds/rog-ally/rog-xbox-ally-x-2025/ ?utm_source=asus-local&amp;utm_medium=blog&amp;utm_campaign=25q4_rog_vn&amp;utm_content=backlink_kw_rogxboxallyx\" target=\"_blank\">ROG Xbox Ally X</a>) đ&atilde; khẳng định vị thế l&agrave; thiết bị gaming cầm tay chạy hệ điều h&agrave;nh Windows 11 h&agrave;ng đầu. Trọng t&acirc;m của Xbox Ally Series kh&ocirc;ng chỉ nằm ở sức mạnh tức thời m&agrave; c&ograve;n ở khả năng <span class=\"highlight\">duy tr&igrave; hiệu suất</span>, <span class=\"highlight\">tối ưu h&oacute;a phần mềm</span> v&agrave; <span class=\"highlight\">t&iacute;nh thoải m&aacute;i</span> trong c&aacute;c phi&ecirc;n chơi game k&eacute;o d&agrave;i.</p>\r\n</div>\r\n\r\n<div class=\"content-block\">\r\n<h2>HIỆU NĂNG TỐI ƯU VỚI AMD Z2 SERIES</h2>\r\n\r\n<div class=\"dual-image-container\">\r\n<div class=\"dual-image-container\"><!-- Placeholder for the second image to be placed next to the first one --><img  accesskey=\"38926\" alt=\"1.KV (1)\" src=\"https://rog.asus.com/media/1761936939141.jpg\" style=\"width: 387px; height: 387px;\" /></div>\r\n\r\n<div class=\"dual-image-container\"><!-- Placeholder for the second image to be placed next to the first one --><img  accesskey=\"38927\" alt=\"1.KV (2)\" src=\"https://rog.asus.com/media/1761936969193.jpg\" style=\"width: 387px; height: 387px;\" /></div>\r\n\r\n<p>Cấu tr&uacute;c của <a href=\"https://vn.store.asus.com/rog-xbox-ally?utm_source=rog-local&amp;utm_medium=blog&amp;utm_campaign=25q4_rog_vn&amp;utm_content=backlink_kw_rogxboxallyseries\" target=\"_blank\">ROG Xbox Ally Series</a> được x&acirc;y dựng dựa tr&ecirc;n hiệu suất năng lượng của bộ vi xử l&yacute; <span class=\"highlight\">AMD Ryzen&trade; Z2 Series</span>. Sự kết hợp giữa <span class=\"highlight\">Z2 Extreme</span> v&agrave; <span class=\"highlight\">Z2 A</span> đảm bảo thiết bị cung cấp hiệu suất đồ họa ấn tượng với mức ti&ecirc;u thụ điện năng được kiểm so&aacute;t chặt chẽ, tối ưu cho trải nghiệm chơi game di động.</p>\r\n\r\n<ul>\r\n\t<li><span class=\"highlight\">Bộ xử l&yacute; chuy&ecirc;n dụng:</span> AMD Ryzen Z2 Series được thiết kế đặc biệt cho c&aacute;c thiết bị cầm tay, c&acirc;n bằng giữa tốc độ xử l&yacute; v&agrave; hiệu quả năng lượng.</li>\r\n\t<li><span class=\"highlight\">Hệ thống tản nhiệt Zero Gravity:</span> Đảm bảo thiết bị hoạt động ổn định v&agrave; m&aacute;t mẻ ngay cả khi xử l&yacute; c&aacute;c tựa game AAA nặng, nhờ v&agrave;o quạt k&eacute;p v&agrave; ống dẫn nhiệt ti&ecirc;n tiến.</li>\r\n</ul>\r\n</div>\r\n\r\n<div class=\"image-container\"><!-- Placeholder image for the series, emphasizing portability and power --><img  accesskey=\"38922\" alt=\"ROG Xbox Ally &amp; Ally X (3)\" src=\"https://rog.asus.com/media/1761933801169.jpg\" /></div>\r\n\r\n<div class=\"content-block\">\r\n<h2>THIẾT KẾ C&Ocirc;NG TH&Aacute;I HỌC V&Agrave; ĐỘ BỀN VỮNG</h2>\r\n\r\n<p><a href=\"https://vn.store.asus.com/rog-xbox-ally?utm_source=rog-local&amp;utm_medium=blog&amp;utm_campaign=25q4_rog_vn&amp;utm_content=backlink_kw_rogxboxallyseries\" target=\"_blank\">ROG Xbox Ally Series</a> được thiết kế với cảm hứng từ tay cầm Xbox, ưu ti&ecirc;n sự thoải m&aacute;i của game thủ, một yếu tố quan trọng cho c&aacute;c phi&ecirc;n chơi game k&eacute;o d&agrave;i:</p>\r\n\r\n<div class=\"dual-image-container\">\r\n<div class=\"dual-image-container\"><!-- Placeholder for the second image to be placed next to the first one --><img  accesskey=\"38924\" alt=\"6.Panel_ Audio\" src=\"https://rog.asus.com/media/1761935010227.jpg\" style=\"width: 387px; height: 387px;\" /></div>\r\n\r\n<div class=\"dual-image-container\"><!-- Placeholder for the second image to be placed next to the first one --><img  accesskey=\"38925\" alt=\"5.impulse trigger\" src=\"https://rog.asus.com/media/1761935140794.jpg\" style=\"width: 387px; height: 387px;\" /></div>\r\n</div>\r\n\r\n<ul>\r\n\t<li><span class=\"highlight\">Kiểm so&aacute;t Ch&iacute;nh x&aacute;c:</span> Trang bị c&aacute;c n&uacute;t bấm v&agrave; cần analog c&oacute; độ ch&iacute;nh x&aacute;c cao, c&ugrave;ng với <span class=\"highlight\">HD haptics</span> v&agrave; <span class=\"highlight\">6-Axis IMU</span>, mang lại phản hồi vật l&yacute; ch&acirc;n thực.</li>\r\n\t<li><span class=\"highlight\">M&agrave;n h&igrave;nh Tối ưu:</span> M&agrave;n h&igrave;nh <span class=\"highlight\">7-inch FHD (1080p)</span> với tần số qu&eacute;t <span class=\"highlight\">120Hz</span> v&agrave; <span class=\"highlight\">FreeSync&trade; Premium</span> loại bỏ hiện tượng x&eacute; h&igrave;nh. M&agrave;n h&igrave;nh được bảo vệ bằng <span class=\"highlight\">Corning&reg; Gorilla&reg; Glass Vitus&reg;</span> v&agrave; lớp phủ chống phản chiếu <span class=\"highlight\">DXC Anti-Reflection</span>, tăng độ bền v&agrave; khả năng hiển thị ngo&agrave;i trời.</li>\r\n\t<li><span class=\"highlight\">Thiết kế n&acirc;ng cấp Xbox Ally X:</span> Phi&ecirc;n bản <a href=\"/vn/gaming-handhelds/rog-ally/rog-xbox-ally-x-2025/ ?utm_source=asus-local&amp;utm_medium=blog&amp;utm_campaign=25q4_rog_vn&amp;utm_content=backlink_kw_rogxboxallyx\" target=\"_blank\">Xbox Ally X </a>đ&atilde; cải thiện chất lượng của cần analog, D-Pad v&agrave; th&ecirc;m c&aacute;c n&uacute;t bấm sau c&oacute; thể g&aacute;n chức năng (assignable back buttons), n&acirc;ng cao đ&aacute;ng kể trải nghiệm cầm nắm.</li>\r\n</ul>\r\n</div>\r\n\r\n<div class=\"image-container\"><!-- Placeholder image for the cooling system or internal components --><img  accesskey=\"38931\" alt=\"ROG Xbox Ally &amp; Ally X (21)\" src=\"https://rog.asus.com/media/1761937381646.jpg\" /></div>\r\n\r\n<div class=\"content-block\">\r\n<h2>HỆ SINH TH&Aacute;I KH&Ocirc;NG GIỚI HẠN V&Agrave; T&Iacute;NH N&Acirc;NG CẤP</h2>\r\n\r\n<div class=\"dual-image-container\">\r\n<div class=\"dual-image-container\"><!-- Placeholder for the second image to be placed next to the first one --><img  accesskey=\"38928\" alt=\"7.Play without limits\" src=\"https://rog.asus.com/media/1761937199226.jpg\" style=\"width: 387px; height: 387px;\" /></div>\r\n\r\n<div class=\"dual-image-container\"><!-- Placeholder for the second image to be placed next to the first one --><img  accesskey=\"38929\" alt=\"13. Xbox game bar\" src=\"https://rog.asus.com/media/1761937227895.jpg\" style=\"width: 387px; height: 387px;\" /></div>\r\n</div>\r\n\r\n<p>Sức mạnh thực sự của <a href=\"https://vn.store.asus.com/rog-xbox-ally?utm_source=rog-local&amp;utm_medium=blog&amp;utm_campaign=25q4_rog_vn&amp;utm_content=backlink_kw_rogxboxallyseries\" target=\"_blank\">Xbox Ally Series</a> nằm ở khả năng t&iacute;ch hợp phần mềm v&agrave; t&ugrave;y chọn n&acirc;ng cấp linh hoạt, k&eacute;o d&agrave;i tuổi thọ của thiết bị:</p>\r\n\r\n<ul>\r\n\t<li><span class=\"highlight\">Ecosystem Xbox To&agrave;n Diện:</span> T&iacute;ch hợp giao diện Xbox Game Bar v&agrave; thư viện game đa dạng của Windows 11, cho ph&eacute;p truy cập gần như kh&ocirc;ng giới hạn c&aacute;c nền tảng game (Steam, Epic, Game Pass).</li>\r\n\t<li><span class=\"highlight\">Armoury Crate SE:</span> Cổng th&ocirc;ng tin duy nhất để quản l&yacute; mọi tựa game, thiết lập cấu h&igrave;nh v&agrave; t&ugrave;y chỉnh c&aacute;c chế độ hoạt động của m&aacute;y một c&aacute;ch trực quan.</li>\r\n\t<li><span class=\"highlight\">Pin &amp; N&acirc;ng cấp (Ally X):</span> Vi&ecirc;n pin dung lượng lớn <span class=\"highlight\">80Wh</span> tr&ecirc;n <a href=\"/vn/gaming-handhelds/rog-ally/rog-xbox-ally-x-2025/ ?utm_source=asus-local&amp;utm_medium=blog&amp;utm_campaign=25q4_rog_vn&amp;utm_content=backlink_kw_rogxboxallyx\" target=\"_blank\">Xbox Ally X </a>gi&uacute;p k&eacute;o d&agrave;i đ&aacute;ng kể thời gian chơi game. Th&ecirc;m v&agrave;o đ&oacute;, việc sử dụng chuẩn <span class=\"highlight\">M.2 2280 SSD</span> ti&ecirc;u chuẩn gi&uacute;p người d&ugrave;ng dễ d&agrave;ng n&acirc;ng cấp dung lượng lưu trữ, đảm bảo thiết bị lu&ocirc;n sẵn s&agrave;ng cho c&aacute;c tựa game mới.</li>\r\n</ul>\r\n\r\n<p><img  accesskey=\"38930\" alt=\"ROG Xbox Ally &amp; Ally X (19)\" src=\"https://rog.asus.com/media/176193729025.jpg\" /></p>\r\n</div>\r\n<!-- Bảng Thông số kỹ thuật chi tiết 1: ROG ALLY (TIÊU CHUẨN) -->\r\n\r\n<table class=\"spec-table\">\r\n\t<caption>TH&Ocirc;NG SỐ KỸ THUẬT CƠ BẢN CỦA <a href=\"/vn/gaming-handhelds/rog-ally/rog-xbox-ally-2025/?utm_source=asus-local&amp;utm_medium=blog&amp;utm_campaign=25q4_rog_vn&amp;utm_content=backlink_kw_rogxboxally\" target=\"_blank\">ROG Xbox ALLY</a> (TI&Ecirc;U CHUẨN)</caption>\r\n\t<thead>\r\n\t\t<tr>\r\n\t\t\t<th>Danh mục</th>\r\n\t\t\t<th>Th&ocirc;ng số</th>\r\n\t\t</tr>\r\n\t</thead>\r\n\t<tbody>\r\n\t\t<tr>\r\n\t\t\t<th>Vi xử l&yacute; (CPU)</th>\r\n\t\t\t<td><span class=\"highlight\">AMD Ryzen&trade; Z2 A Processor</span> (hoặc Z1 Extreme)</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>M&agrave;n h&igrave;nh</th>\r\n\t\t\t<td><span class=\"highlight\">7&rdquo; FHD (1080p) IPS</span>, 120Hz, 500 nits, FreeSync&trade; Premium, Corning&reg; Gorilla&reg; Glass Vitus&reg; + DXC Anti-Reflection</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>Bộ nhớ</th>\r\n\t\t\t<td><span class=\"highlight\">16GB LPDDR5X-6400</span></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>Lưu trữ</th>\r\n\t\t\t<td>512GB M.2 2230 SSD (Sử dụng khe 2230)</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>Pin</th>\r\n\t\t\t<td><span class=\"highlight\">40Wh</span></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>Cổng kết nối</th>\r\n\t\t\t<td>1x USB-C (DP/PD), 1x XG Mobile Interface, 1x UHS-II microSD card reader</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>Trọng lượng</th>\r\n\t\t\t<td><span class=\"highlight\">608g</span></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>Phần mềm</th>\r\n\t\t\t<td>Windows 11 Home + Armoury Crate SE</td>\r\n\t\t</tr>\r\n\t</tbody>\r\n</table>\r\n<!-- Bảng Thông số kỹ thuật chi tiết 2: ROG ALLY X (PHIÊN BẢN NÂNG CẤP) -->\r\n\r\n<table class=\"spec-table\">\r\n\t<caption>TH&Ocirc;NG SỐ KỸ THUẬT CƠ BẢN CỦA <a href=\"/vn/gaming-handhelds/rog-ally/rog-xbox-ally-x-2025/ ?utm_source=asus-local&amp;utm_medium=blog&amp;utm_campaign=25q4_rog_vn&amp;utm_content=backlink_kw_rogxboxallyx\" target=\"_blank\">ROG xbox ALLY X</a> (N&Acirc;NG CẤP)</caption>\r\n\t<thead>\r\n\t\t<tr>\r\n\t\t\t<th>Danh mục</th>\r\n\t\t\t<th>Th&ocirc;ng số</th>\r\n\t\t</tr>\r\n\t</thead>\r\n\t<tbody>\r\n\t\t<tr>\r\n\t\t\t<th>Vi xử l&yacute; (CPU)</th>\r\n\t\t\t<td><span class=\"highlight\">AMD Ryzen&trade; Z1 Extreme Processor</span></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>M&agrave;n h&igrave;nh</th>\r\n\t\t\t<td><span class=\"highlight\">7&rdquo; FHD (1080p) IPS</span>, 120Hz, 500 nits, FreeSync&trade; Premium, Corning&reg; Gorilla&reg; Glass Vitus&reg; + DXC Anti-Reflection</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>Bộ nhớ</th>\r\n\t\t\t<td><span class=\"highlight\">24GB LPDDR5X-7500</span></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>Lưu trữ</th>\r\n\t\t\t<td><span class=\"highlight\">1TB M.2 2280 SSD</span> (Sử dụng chuẩn 2280 dễ n&acirc;ng cấp)</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>Pin</th>\r\n\t\t\t<td><span class=\"highlight\">80Wh</span> (Gấp đ&ocirc;i phi&ecirc;n bản ti&ecirc;u chuẩn)</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>Cổng kết nối</th>\r\n\t\t\t<td><span class=\"highlight\">2x USB-C (1x TB4/USB4, 1x 3.2 Gen 2)</span>, 1x UHS-II microSD card reader (Đ&atilde; loại bỏ XG Mobile Interface)</td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>Trọng lượng</th>\r\n\t\t\t<td><span class=\"highlight\">678g</span></td>\r\n\t\t</tr>\r\n\t\t<tr>\r\n\t\t\t<th>Phần mềm</th>\r\n\t\t\t<td>Windows 11 Home + Armoury Crate SE</td>\r\n\t\t</tr>\r\n\t</tbody>\r\n</table>\r\n\r\n