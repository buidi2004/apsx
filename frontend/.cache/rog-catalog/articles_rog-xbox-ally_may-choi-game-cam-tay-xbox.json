      padding: 40px 0;\r\n            border-bottom: 2px solid #D9001B; /* Màu đỏ ROG */\r\n        }\r\n        header h1 {\r\n            color: #D9001B;\r\n            font-size: 2.5em;\r\n            margin-bottom: 10px;\r\n            text-transform: uppercase; /* Tiêu đề chính viết hoa */\r\n            font-weight: 700;\r\n        }\r\n        /* Các Phần Nội dung */\r\n        .content-block {\r\n            margin-bottom: 40px;\r\n        }\r\n        h2 {\r\n            color: #FF405B;\r\n            font-size: 1.8em;\r\n            padding-left: 0; \r\n            margin-top: 0;\r\n            text-transform: uppercase; \r\n            font-weight: 700;\r\n        }\r\n        .highlight {\r\n            color: #FFFFFF; \r\n            font-weight: 700;\r\n        }\r\n        /* Hình ảnh */\r\n        .image-container {\r\n            margin: 30px 0;\r\n            text-align: center;\r\n        }\r\n        .image-container img {\r\n            max-width: 100%;\r\n            height: auto;\r\n            border-radius: 8px;\r\n            box-shadow: 0 0 15px rgba(217, 0, 27, 0.3);\r\n        }\r\n   /* Flexbox cho 2 ảnh kế nhau */\r\n        .dual-image-container {\r\n            display: flex;\r\n            flex-wrap: wrap; \r\n            gap: 20px; \r\n            margin: 30px 0;\r\n            justify-content: center;\r\n        }\r\n        .dual-image-container .image-item {\r\n            flex: 1; \r\n            min-width: 300px; \r\n            max-width: 48%; \r\n            text-align: center;\r\n            /* Đảm bảo khung chứa có tỷ lệ 1:1 */\r\n            position: relative;\r\n            padding-bottom: 48%; /* 100% của chiều rộng cha để tạo tỷ lệ 1:1 (khi flex:1 max-width:48% thì 48% là phù hợp) */\r\n            height: 0;\r\n            overflow: hidden; /* Cắt phần tràn ra */\r\n        }\r\n        .dual-image-container .image-item img {\r\n            position: absolute;\r\n            top: 0;\r\n            left: 0;\r\n            width: 100%;\r\n            height: 100%;\r\n            object-fit: cover; /* Đảm bảo hình ảnh lấp đầy khung mà không bị méo */\r\n            border-radius: 8px;\r\n            box-shadow: 0 0 15px rgba(217, 0, 27, 0.3);\r\n        }\r\n        /* Danh sách */\r\n        ul {\r\n            padding-left: 20px;\r\n            list-style-type: none; \r\n        }\r\n        ul li:before {\r\n            content: \"✦\"; /* Dùng ký hiệu thay thế */\r\n            color: #D9001B;\r\n            display: inline-block; \r\n            width: 1em;\r\n            margin-left: -1em;\r\n        }\r\n        ul li {\r\n            margin-bottom: 10px;\r\n        }\r\n        /* Call to Action */\r\n        .cta {\r\n            text-align: center;\r\n            margin-top: 60px; \r\n            padding: 10px; \r\n            font-size: 1.1em; \r\n            font-weight: 700;\r\n            color: #FF405B; \r\n        }\r\n        .cta p {\r\n            margin: 5px 0;\r\n        }\r\n        .cta a {\r\n            color: #FFFFFF;\r\n            text-decoration: none;\r\n            background-color: #D9001B; \r\n            padding: 10px 25px;\r\n            border-radius: 5px;\r\n            display: inline-block;\r\n            margin-top: 15px;\r\n            transition: background-color 0.3s;\r\n        }\r\n        .cta a:hover {\r\n            background-color: #FF405B;\r\n        }\r\n        /* Bảng Thông số kỹ thuật (Spec Table) */\r\n        .spec-table {\r\n            width: 100%;\r\n            margin: 40px 0;\r\n            border-collapse: collapse;\r\n            font-size: 0.95em;\r\n            box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);\r\n        }\r\n        .spec-table caption {\r\n            text-align: left;\r\n            font-size: 1.5em;\r\n            font-weight: 700;\r\n            color: #FF405B;\r\n            margin-bottom: 15px;\r\n            text-transform: uppercase;\r\n        }\r\n        .spec-table th, .spec-table td {\r\n            padding: 12px 15px;\r\n            text-align: left;\r\n            border-bottom: 1px solid #333; /* Đường kẻ mỏng */\r\n        }\r\n        .spec-table th {\r\n            background-color: #222; /* Nền hàng tiêu đề */\r\n            color: #D9001B;\r\n            width: 30%; \r\n            font-weight: 700;\r\n        }\r\n        .spec-table td {\r\n            background-color: #1A1A1A; /* Nền hàng dữ liệu */\r\n        }\r\n        .spec-table tr:hover td {\r\n            background-color: #252525; /* Hiệu ứng hover nhẹ */\r\n        }\r\n        .spec-table tr:last-child th, .spec-table tr:last-child td {\r\n            border-bottom: none;\r\n        }\r\n"],"mainHtml":"<main class=\"layout\"><div id=\"rogContent\" class=\"ArticlePost__articlePostPage__77Z3R\"><div class=\"ArticlePost__articlePostWrapper__xtKJQ\"><div class=\"ArticlePost__articlePostContainer__HgGL4 rog-articles\"><div class=\"ArticlePost__articleHeader__t56zw\"><div class=\"ArticlePost__articleInfo__0+TnA\"><div class=\"ArticlePost__deskTopContent__lKBe-\"><i class=\"ArticlePost__iconCalendar__9h+PY\"></i> <i class=\"ArticlePost__iconCalendar__9h+PY\"></i> <i class=\"ArticlePost__iconCalendar__9h+PY\"></i> <i class=\"ArticlePost__iconCalendar__9h+PY\"></i> <i class=\"ArticlePost__iconCalendar__9h+PY\"></i> <span>Oct 31, 2025</span></div></div> <div class=\"ArticlePost__title__r6050\"><h1>ROG Xbox Ally và ROG Xbox Ally X - Máy chơi game cầm tay ROG Xbox đầu tiên tại Việt Nam</h1></div></div> <div class=\"ArticlePost__content__b6FwI articleContent articles-content\"><style type=\"text/css\">h1,h2,h3,h4,h5{\r\n          font-family: 'Roboto Condensed' !important;\r\n          font-weight: 700 !important;\r\n        }\r\n</style>\r\n<meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n<title></title>\r\n<link href=\"https://fonts.googleapis.com/css2?family=Roboto+Condensed:wght@400;700&amp;display=swap\" rel=\"stylesheet\" />\r\n<style typ