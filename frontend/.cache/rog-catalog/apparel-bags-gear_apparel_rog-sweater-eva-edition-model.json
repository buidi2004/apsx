bg_plus_01.png\" alt=\"\">\n                <div style=\"font-family:Arial !important\" class=\"pd_box\">\n                    <img  class=\"bg_plus_02\" src=\"https://dlcdnwebimgs.asus.com/files/media/71D0D4C5-49A1-42FC-87B8-BB9C0317A2D2/v1/img/bg_plus_02.png\" alt=\"\">\n                    <img  class=\"pd\" src=\"https://dlcdnwebimgs.asus.com/files/media/71D0D4C5-49A1-42FC-87B8-BB9C0317A2D2/v1/img/plus_pd.png\" alt=\"ROG Strix XG27AQM EVA edition product photo\">\n                </div>   \n            </div>\n            <div style=\"font-family:Arial !important\" class=\"product-content\">\n                <div style=\"font-family:Arial !important\" class=\"maintitle\">\n                    <h2 style=\"font-family:Arial !important\" class=\"text-left\">RICH CONNECTIVITY AND AURA SYNC LIGHTING</h2>\n                    <div style=\"font-family:Arial !important\" class=\"info text-left\">ROG Strix XG27AQM EVA EDITION includes ambient lighting that can be synchronized with other Aura-enabled components and peripherals.</div>\n                    <a class=\"Wheretobuy\" href=\"#\" Aria-label=\"where to buy ROG Strix XG27AQM EVA edition\"><p style=\"font-family:Arial !important\">More Product Information //</p></a>\n                </div>\n            </div>\n        </section> -->\n\n</div>\n\n<!-- //////////////////////////////////////////////\n#sectionOverview  @END\n////////////////////////////////////////////// -->\n\n<script src=\"https://dlcdnwebimgs.asus.com/files/media/71D0D4C5-49A1-42FC-87B8-BB9C0317A2D2/v1/js/main.js\"></script>\n<!-- <script src=\"https://dlcdnwebimgs.asus.com/files/media/71D0D4C5-49A1-42FC-87B8-BB9C0317A2D2/v1/js/libs/gototop.js\"></script> -->\n<script src=\"https://dlcdnwebimgs.asus.com/files/media/71D0D4C5-49A1-42FC-87B8-BB9C0317A2D2/v1/js/libs/jquery.navScroll.js\"></script>\n<script src=\"https://dlcdnwebimgs.asus.com/files/media/71D0D4C5-49A1-42FC-87B8-BB9C0317A2D2/v1/js/libs/scrollreveal.min.js\"></script>\n<!-- <script src=\"ht