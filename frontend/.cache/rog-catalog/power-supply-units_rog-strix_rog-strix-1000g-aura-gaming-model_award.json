-video tabpanel-media\" id=\"All\" class=\"awardItem ProductAwards__awardTab__yaTHJ ProductAwards__active__9TvSy\">\n          All\n      </li> <li aria-label=\"ROG STRIX 1000W Gold Aura Edition Giải thưởng\" role=\"tab\" tabindex=\"-1\" aria-controls=\"tabpanel-awards\" id=\"Giải_thưởng\" class=\"awardItem ProductAwards__awardTab__yaTHJ\" style=\"display:;\">\n          Giải thưởng\n      </li> <li aria-label=\"ROG STRIX 1000W Gold Aura Edition Video review\" role=\"tab\" tabindex=\"-1\" aria-controls=\"tabpanel-video\" id=\"Video_review\" class=\"awardItem ProductAwards__awardTab__yaTHJ\" style=\"display:;\">\n          Video review\n      </li> <li aria-label=\"ROG STRIX 1000W Gold Aura Edition Media review\" role=\"tab\" tabindex=\"-1\" aria-controls=\"tabpanel-media\" id=\"Media_review\" class=\"awardItem ProductAwards__awardTab__yaTHJ\" style=\"display:none;\">\n          Media review\n      </li></ul></div> <div id=\"tabpanel-awards\" role=\"tabpanel\" aria-labelledby=\"Giải_thưởng\"><div class=\"ProductAward__productAwardPagePadding__dSaZj\"><div class=\"ProductAward__awardTitle__GUset\"><h2 class=\"pageAward vnRogFont ProductAward__vnRogFontSize__5eSiT\">\n        Giải thưởng \n      </h2> <span>(2)</span></div> <div class=\"ProductAward__mobileAwardContent__LNDCh\"><ul class=\"ProductAward__rewardContainer__sHbkR ProductAward__rewardItemLessThanThree__qeW8A\" style=\"width:100%;\"><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1263/201911281814123100179.png\" alt=\"\" aria-label=\"4 stars and a half out of 5\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      GinjFo\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>4 stars and a half out of 5</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      This ROG Strix 1000G Aura Edition is a solid power supply for a Gaming PC. ATX 3.0, it supports the latest generations of graphics cards, while its 1 KW of power meets the needs of a muscular, power-hungry platform.\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>FRANCE</span> <span>06/08/2023</span></div> <a aria-label=\"ROG STRIX 1000W Gold Aura Edition Media review Award of 4 stars and a half out of 5\" tabindex=\"0\" href=\"https://www.ginjfo.com/dossiers/tests-materiel/composants/alimentations/test-rog-strix-1000g-aura-edition-dasus-20230608\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1350/201911191849478810279.png\" alt=\"\" aria-label=\"Best Performance\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      www.vmodtech.com\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>Best Performance</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      Beautiful and outstanding design, elegant with an aluminum case that emphasizes durability and good heat dissipation with a 135 mm Axial-tech Fan Design that increases air pressure. There is a 0dB system that makes low noise. Stable power supply with 80 PLUS Gold standards and Lambda A+ Certification. There is a full 10-year warranty. It meets the needs of gamers and creators who want durability and peace of mind.\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>THAILAND</span> <span>08/11/2024</span></div> <a aria-label=\"ROG STRIX 1000W Gold Aura Edition Media review Award of Best Performance\" tabindex=\"0\" href=\"https://www.vmodtech.com/th/article/asus-rog-strix-1000w-gold-aura-edition-review\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li></ul></div> <!----></div> <!----></div> <div id=\"tabpanel-video\" role=\"tabpanel\" aria-labelledby=\"Video_review\" class=\"ProductAwardVideo__productAwardPagePadding__Z+Cw7\"><div class=\"ProductAwardVideo__line__wNtmI\" style=\"display:;\"></div> <div class=\"ProductAwardVideo__videoWrapper__-NXix\"><div class=\"ProductAwardVideo__videoReviewTitle__0lBVH\" style=\"display:;\"><h2 class=\"pageVideo vnRogFont ProductAwardVideo__vnRogFontSize__n4Ouu\">Video review</h2> <span style=\"display:;\">(30)</span></div> <div class=\"ProductAwardVideo__videoContentScroll__+rpKV\"><ul class=\"ProductAwardVideo__videoContainer__SWxvv\" style=\"width:100%;\"><li class=\"ActionVideo__actionVideoContent__VSBOn ActionVideo__reviewVideo__ItQ8T ProductAwardVideo__videoReviewItem__r730n\"><button type=\"link\" tabindex=\"0\" class=\"VideoButton__videoButton__XVz9e VideoButton__overviewVideoButton__d9DBl ActionVideo__videoBtn__bsfVJ\"><span class=\"sr-only\">play</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" svg-inline role=\"presentation\" focusable=\"false\"><path d=\"M2.24 12a14.32 14.32 0 0127.52 0h1.74a16 16 0 00-31 0zm27.52 8a14.32 14