class=\"ProductOverviewAwardsContent__productAwardContainer__JF3vK ProductOverviewAwardsContent__black__p4RLG\"><h2 class=\"awardTitle vnRogFont ProductOverviewAwardsContent__vnRogFontSize__G4nLE\">Giải thưởng</h2> <div class=\"ProductOverviewAwardsContent__productAwardPage__VsRsr\"><button type=\"button\" aria-label=\"Previous slide\" class=\"ProductOverviewAwardsContent__leftButton__Be29v\" style=\"display:none;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"72\" height=\"72\" viewBox=\"0 0 72 72\" svg-inline alt=\"slide prev\" role=\"presentation\" focusable=\"false\"><defs><clipPath id=\"a\"><path data-name=\"矩形 11055\" transform=\"translate(-11812 4633)\" d=\"M0 0h72v72H0z\" fill=\"none\"></path></clipPath></defs><g data-name=\"icon-arrow-big\" transform=\"translate(11812 -4633)\" clip-path=\"url(#a)\"><path data-name=\"联合 614\" d=\"M-11787 4697l18-28h4l-18 28zm18-28l-18-28h4l18 28z\" fill=\"#fff\"></path></g></svg></button> <button type=\"button\" aria-label=\"Next Slide\" class=\"ProductOverviewAwardsContent__rightButton__NDVSj\" style=\"display:none;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"72\" height=\"72\" viewBox=\"0 0 72 72\" svg-inline alt=\"slide next\" role=\"presentation\" focusable=\"false\"><defs><clipPath id=\"a\"><path data-name=\"矩形 11055\" transform=\"translate(-11812 4633)\" d=\"M0 0h72v72H0z\" fill=\"none\"></path></clipPath></defs><g data-name=\"icon-arrow-big\" transform=\"translate(11812 -4633)\" clip-path=\"url(#a)\"><path data-name=\"联合 614\" d=\"M-11787 4697l18-28h4l-18 28zm18-28l-18-28h4l18 28z\" fill=\"#fff\"></path></g></svg></button> <div class=\"ProductOverviewAwardsContent__productAwardWrapper__uKQ3+\"><div class=\"ProductOverviewAwardsContent__rewardContainer__DcEna ProductOverviewAwardsContent__productAwardItemLessThanThree__ppiZq ProductOverviewAwardsContent__productAwardItemOnlyOne__T6p46\" style=\"width:1000%;transform:translate3d(0px, 0, 0);\"><div class=\"ProductOverviewAwardsItem__rewardItem__Pqq8U ProductOverviewAwardsItem__rewardItemLessThanThree__P9dm7 ProductOverviewAwardsItem__oneItem__19-Tc\"><a href=\"https://mmosite.vn/trai-nghiem-tinh-nang-thay-switch-cho-chuot-gaming-push-fit-switch-socket-tu-asus/\" aria-label=\"link0 Award of MMOsite Editor's Choice\" tabindex=\"0\" target=\"_blank\" rel=\"noopener noreferrer\"><div class=\"ProductOverviewAwardsItem__rewardImageWrapper__Hrxbu\"><div role=\"presentation\" class=\"ProductOverviewAwardsItem__rewardImageBox__3iTki\"><img  src=\"https://www.asus.com/media/images/award_logo/1343/202004191811088460706.png\" alt=\"\" aria-label=\"MMOsite Editor's Choice\" tabindex=\"-1\" loading=\"lazy\"> <p class=\"ProductOverviewAwardsItem__rewardItemName__eeEOl\" style=\"width:0;height:0;\">\n          MMOsite Editor's Choice\n        </p> <p style=\"width:0;height:0;\">\n          TRẢI NGHIỆM TÍNH NĂNG THAY SWITCH CHO CHUỘT GAMING – PUSH FIT SWITCH SOCKET TỪ ASUS\n        </p></div> <!----></div> <p class=\"ProductOverviewAwardsItem__rewardItemName__eeEOl\">\n      MMOsite Editor's Choice\n    </p> <p>\n      TRẢI NGHIỆM TÍNH NĂNG THAY SWITCH CHO CHUỘT GAMING – PUSH FIT SWITCH SOCKET TỪ ASUS\n    </p></a></div></div></div></div></div> <!----> <!----></div></div> <div><div dir=\"auto\" class=\"overContent\" style=\"background:#000000;color:#202020;overflow:hidden !important;\"><div class=\"container\">\n    <div\n      id=\"hd\"\n      style=\"\n        position: absolute;\n        width: 100%;\n        left: 0;\n        overflow: hidden;\n        z-index: 0;\n      \"\n    >\n      \n    <link rel=\"stylesheet\" href=\"https://dlcdnwebimgs.asus.com/files/media/6C41F397-87A4-47AE-882E-AC7EA52D9432/css/main.css\" />\n    <link rel=\"stylesheet\" href=\"https://dlcdnwebimgs.asus.com/files/media/6C41F397-87A4-47AE-882E-AC7EA52D9432/lib/owl-carousel/owl.carousel.css\" />\n    <link rel=\"stylesheet\" href=\"https://dlcdnwebimgs.asus.com/files/media/6C41F397-87A4-47AE-882E-AC7EA52D9432/css/jquery.full_page.css\" />\n    <link rel=\"stylesheet\" href=\"https://dlcdnwebimgs.asus.com/files/media/6C41F397-87A4-47AE-882E-AC7EA52D9432/css/index.css\" />\n      <section id=\"level-up\">\n        <img  class=\"bg\" src=\"https://dlcdnwebimgs.asus.com/files/media/6C41F397-87A4-47AE-882E-AC7EA52D9432/img/01-kv.png\" alt=\"Level Up\" />\n        <img  class=\"bg_mo\" src=\"https://dlcdnwebimgs.asus.com/files/media/6C41F397-87A4-47AE-882E-AC7EA52D9432/img/01-kv_mob.png\" alt=\"Level Up - mobile\" />\n        <div class=\"text\">\n          <div class=\"w1400\">\n            <div class=\"in\">\n              <h3 style=\"font-family:Arial !important\">Thay áo mới cho bàn phím chơi game ROG RX của bạn</h3>\n              <p style=\"font-family:Arial !important\" class=\"description\">\n                Bộ keycap ROG PBT Doubleshot cho switch ROG RX được gia công chuẩn xác từ chất liệu PBT cao cấp giúp mang lại cảm giác nhấn phím khác biệt và độ bền sử dụng lâu dài. Thiết kế huyền thoại ROG gắn liền với phong cách futuristic (hơi hướng tương lai) cùng lớp hoàn thiện trong đục được sơn lót đảm bảo ánh sáng đèn có thể đi xuyên qua keycap và tỏa sáng ấn tượng cho bàn phím. Đã đến lúc thay đổi và làm chủ cuộc chơi ―  với keycap ROG PBT Doubleshot dành cho switch ROG RX! \n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"premium\">\n        <img  class=\"bg\" src=\"https://dlcdnwebimgs.asus.com/files/media/6C41F397-87A4-47AE-882E-AC7EA52D9432/img/02.png\" alt=\"Premium\" />\n        <div class=\"text\">\n          <div class=\"w1400\">\n            <div class=\"in\">\n              <h3 style=\"font-family:Arial !important\">Chất liệu PBT cao cấp</h3>\n              <p style=\"font-family:Arial !important\" class=\"description\">\n                Mỗi keycap đều được làm từ chất liệu PBT chất lượng cao để mang lại cảm giác gõ chắc chắn và độ bền lâu dài. Các keycap cao cấp cũng cung cấp khả năng chống mài mòn bề mặt tuyệt vời, ngăn ngừa keycap bị bóng – đảm bảo cảm giác xài như mới trong một thời gian dài. \n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"double-shot\">\n        <div class=\"text\">\n          <div class=\"w1400\">\n            <div class=\"wrap\">\n              <div class=\"in\">\n                <h3 style=\"font-family:Arial !important\">Được gia công 2 lớp (doubleshot)<br />Keycap</h3>\n                <p style=\"font-family:Arial !important\" class=\"description\">\n                  Quy trình gia công 2 lớp (doubleshot) tạo ra các keycap trong đục có logo  ROG huyền thoại để mang đến vẻ ngoài độc đáo, cho bàn phím của bạn tỏa sáng hoàn hảo với thiết kế đặc trưng không thể nhầm lẫn của ROG.\n                </p>\n              </div>\n\n              <div class=\"img-wrap\">\n                <img \n                  class=\"img-center\"\n                  src=\"https://dlcdnwebimgs.asus.com/files/media/6C41F397-87A4-47AE-882E-AC7EA52D9432/img/03-circle.png\"\n                  alt=\"circle-img\"\n                />\n              </div>\n            </div>\n          </div>\n        </div>\n        <img  class=\"bg\" src=\"https://dlcdnwebimgs.asus.com/files/media/6C41F397-87A4-47AE-882E-AC7EA52D9432/img/03-pd.png\" alt=\"\" />\n      </section>\n\n      <section id=\"switch\">\n        <img  class=\"bg\" src=\"https://dlcdnwebimgs.asus.com/files/media/6C41F397-87A4-47AE-882E-AC7EA52D9432/img/04-bg.png\" alt=\"switch\" />\n        <div class=\"text\">\n          <div class=\"w1400\">\n            <div class=\"in\">\n              <h3 style=\"font-family:Arial !important\">Dành cho bàn phím sử dụng switch ROG RX</h3>\n              <p style=\"font-family:Arial !important\" class=\"description\">\n                Bộ keycap ROG PBT Doubleshot dành cho switch ROG RX tương thích với các bàn phím được trang bị switch ROG RX. Chúng tôi thậm chí còn tặng kèm một dụng cụ gỡ keycap (ROG Keycap Puller) độc quyền trong gói sản phẩm, vì vậ