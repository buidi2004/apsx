tabpanel-media\" id=\"All\" class=\"awardItem ProductAwards__awardTab__yaTHJ ProductAwards__active__9TvSy\">\n          All\n      </li> <li aria-label=\"ROG Strix Impact III Wireless Giải thưởng\" role=\"tab\" tabindex=\"-1\" aria-controls=\"tabpanel-awards\" id=\"Giải_thưởng\" class=\"awardItem ProductAwards__awardTab__yaTHJ\" style=\"display:;\">\n          Giải thưởng\n      </li> <li aria-label=\"ROG Strix Impact III Wireless Video review\" role=\"tab\" tabindex=\"-1\" aria-controls=\"tabpanel-video\" id=\"Video_review\" class=\"awardItem ProductAwards__awardTab__yaTHJ\" style=\"display:;\">\n          Video review\n      </li> <li aria-label=\"ROG Strix Impact III Wireless Media review\" role=\"tab\" tabindex=\"-1\" aria-controls=\"tabpanel-media\" id=\"Media_review\" class=\"awardItem ProductAwards__awardTab__yaTHJ\" style=\"display:;\">\n          Media review\n      </li></ul></div> <div id=\"tabpanel-awards\" role=\"tabpanel\" aria-labelledby=\"Giải_thưởng\"><div class=\"ProductAward__productAwardPagePadding__dSaZj\"><div class=\"ProductAward__awardTitle__GUset\"><h2 class=\"pageAward vnRogFont ProductAward__vnRogFontSize__5eSiT\">\n        Giải thưởng \n      </h2> <span>(6)</span></div> <div class=\"ProductAward__mobileAwardContent__LNDCh\"><ul class=\"ProductAward__rewardContainer__sHbkR\" style=\"width:100%;\"><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1337/202309061359096690861.png\" alt=\"\" aria-label=\"Platinum\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      Fanaticos del Hardware\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>Platinum</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      unbeatable\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>SPAIN</span> <span>04/11/2024</span></div> <a aria-label=\"ROG Strix Impact III Wireless Media review Award of Platinum\" tabindex=\"0\" href=\"https://fanaticosdelhardware.com/analisis-teclado-rog-azoth-y-raton-asus-rog-strix-impact-iii-wireless/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1350/201911191849478810279.png\" alt=\"\" aria-label=\"Best Performance\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      www.vmodtech.com\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>Best Performance</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      Easy to use wirelessly via USB 2.4 GHz ROG SpeedNova The signal is stable, no lag at all, almost no different from using a wired mouse. The mouse is comfortable to hold, DPI can be adjusted from the mouse, and additional lighting effects can be customized from the ASUS Amoury Crate app.\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>THAILAND</span> <span>01/19/2024</span></div> <a aria-label=\"ROG Strix Impact III Wireless Media review Award of Best Performance\" tabindex=\"0\" href=\"https://www.vmodtech.com/th/article/rog-strix-impact-iii-wireless-ultralight-wireless-gaming-mouse-review\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1281/202409100006554390859.png\" alt=\"\" aria-label=\"4news review\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      4 News\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>4news review</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      The ROG Strix Impact III Wireless turns out to be an extremely good wireless gaming mouse that can compete on equal terms with its main competitors. In fact, it offers truly impressive sensitivity and control for the price range in which it goes, thanks to high-end components such as the 36000 DPI Asus AimPoint sensor, while the ability to replace the Switches with those of our choice is a plus we would like to see in all mice in a certain category. \n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>ITALY</span> <span>08/08/2024</span></div> <a aria-label=\"ROG Strix Impact III Wireless Media review Award of 4news review\" tabindex=\"0\" href=\"https://4news.it/recensione-asus-rog-strix-impact-iii-wireless-rog-moonstone-ace-l/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1250/15466.png\" alt=\"\" aria-label=\"BUG Recommends\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      BUG online\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>BUG Recommends</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      Excellent sensor\n    Great adaptability, despite the simple design\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>CROATIA</span> <span>01/28/2024</span></div> <a aria-label=\"ROG Strix Impact III Wireless Media review Award of BUG Recommends\" tabindex=\"0\" href=\"https://www.bug.hr/preview/c603c36b28ce52cc244be0ff77ff8f3d-37594\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1250/202001151712268190280.png\" alt=\"\" aria-label=\"Recommends award\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      PC Ekspert\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>Recommends award</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      Build quality, design, excellent sensor, long-lasting but changeable microswitches, autonomy, low weight, good mobility.\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>CROATIA</span> <span>12/22/2023</span></div> <a aria-label=\"ROG Strix Impact III Wireless Media review Award of Recommends award\" tabindex=\"0\" href=\"https://www.pcekspert.com/clanak/asus-rog-strix-impact-iii-wireless-recenzija/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/2004/202104280539141140523.png\" alt=\"\" aria-label=\"Editors Choice\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      Svet Kompjutera\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>Editors Choice</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      ROG Strix Impact III is different\na mouse meant for different people,\nwho want to get durable.\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>REPUBLIC OF SERBIA</span> <span>01/01/2024</span></div> <a aria-label=\"ROG Strix Impact III Wireless Media review Award of Editors Choice\" tabindex=\"0\" href=\"https://sk.rs\" target=\"_blank\" rel=\"noopener noreferr