em ProductTabBar__mobileTabItem__KF1TS\"><span>\n                Thư viện\n              </span></li></ul></div></div> <!----> <!----> <div><div dir=\"auto\" class=\"overContent\" style=\"background:#000000;color:#202020;overflow:hidden !important;\"><div id=\"moduleArea\"><div class=\"moduleArticleWrapper\"><div class=\"moduleArticleContent\"><div class=\"container\">\n  <div class=\"inner overview-wrapper\" style=\"width: 100%; overflow: hidden\">\n    <section class=\"overviewContent black_box\">\n      <div\n        class=\"product_overview overview_BlackVersion overview_Special\"\n        style=\"width: 100%\"\n      >\n        <div class=\"charger-wrapper\">\n          <link\n            rel=\"stylesheet\"\n            type=\"text/css\"\n            href=\"https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/css/main.css\"\n            media=\"all\"\n          />\n          <!--Local VN Font-->\n          <style>\n            h3{\n              font-family: \"roboto condensed\" !important;\n              font-weight:  700 !important;\n            }\n          </style>\n          <!--charger sections : kv-->\n          <section class=\"charger-kv charger-section\">\n            <div class=\"main-image\">\n              <picture>\n                <source\n                  srcset=\"\n                    https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/img/01_large.png\n                  \"\n                  media=\"(min-width: 1200px)\"\n                />\n                <source\n                  srcset=\"\n                    https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/img/01_medium.png\n                  \"\n                  media=\"(min-width: 600px)\"\n                />\n                <img  src=\"https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/img/01_small.png\" alt=\"Một người đang lấy điện thoại ra từ túi ROG Archer Carry Bag.\" />\n              </picture>\n            </div>\n            <h2>ROG Archer Carry Bag</h2>\n            <div class=\"charger-text\">\n              <h3 class=\"charger-title\">Bền bỉ mỗi ngày, thuận tiện tối đa</h3>\n              <p class=\"charger-p\">\n                Túi ROG Archer Carry Bag hoàn hảo để sử dụng hằng ngày. Được làm từ chất liệu nylon 200D chống nước bền bỉ, túi có các dây đeo điều chỉnh được, một dây móc khóa ở bên hông, nhiều ngăn và một túi ẩn có khóa kéo ― tất cả giúp giữ an toàn cho các trang bị và đồ giá trị của bạn đồng thời bố trí đồ đạc hợp lý, dễ dàng tiếp cận.</p>\n            </div>\n          </section>\n\n          <section class=\"charger-section\">\n            <div class=\"main-image\">\n              <picture>\n                <source\n                  srcset=\"\n                    https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/img/02_large.png\"\n                  media=\"(min-width: 1200px)\"\n                />\n                <source\n                  srcset=\"\n                    https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/img/02_medium.png\"\n                  media=\"(min-width: 600px)\"\n                />\n                <img  src=\"https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/img/02_small.png\" loading=\"lazy\" alt=\"Một chiếc túi ROG Archer Carry Bag được làm nổi bật với vải chống nước.\" />\n              </picture>\n            </div>\n            <div class=\"charger-text\">\n              <h3 class=\"charger-title\">Bền bỉ và an toàn</h3>\n              <p class=\"charger-p\">\n                Cấu trúc vải nylon 200D chống rách &amp; chống nước khiến túi ROG Archer Carry Bag rất phù hợp để sử dụng hằng ngày, trong mọi điều kiện thời tiết. Túi ẩn có khóa kéo và khóa YKK bền bỉ bảo vệ và giữ an toàn cho các món đồ cá nhân.</p>\n            </div>\n          </section>\n\n          \n          <section class=\"charger-section\">\n            <div class=\"main-image\">\n              <picture>\n                <source\n                  srcset=\"\n                    https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/img/04_large.png\n                  \"\n                  media=\"(min-width: 1200px)\"\n                />\n                <source\n                  srcset=\"\n                    https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/img/04_medium.png\n                  \"\n                  media=\"(min-width: 600px)\"\n                />\n                <img  src=\"https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/img/04_small.png\" loading=\"lazy\" alt=\"Một người đang mang theo túi ROG Archer Carry Bag.\" />\n              </picture>\n            </div>\n          </section>\n\n                    <section class=\"charger-section\">\n            <div class=\"main-image\">\n              <picture>\n                <source\n                  srcset=\"\n                    https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/img/03_large.png\n                  \"\n                  media=\"(min-width: 1200px)\"\n                />\n                <source\n                  srcset=\"\n                    https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/img/03_medium.png\n                  \"\n                  media=\"(min-width: 600px)\"\n                />\n                <img  src=\"https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/img/03_small.png\" loading=\"lazy\" alt=\"Túi ROG Archer Carry Bag mở khóa một phần đặt trên bàn, để lộ ra một cặp kính râm và các món đồ khác bên trong. Dây đeo quanh bụng có thể tháo rời được đặt bên cạnh.\" />\n              </picture>\n            </div>\n            <div class=\"charger-text\">\n              <h3 class=\"charger-title\">Dễ dàng tùy chỉnh và tiện lợi</h3>\n              <p class=\"charger-p\">\n                Túi ROG Archer Carry Bag gồm nhiều dây đeo có thể tháo rời và điều chỉnh theo chiều dài mong muốn khi đeo chéo qua người hoặc khoác trên vai. Ngoài ra, túi còn có ngăn riêng đựng kính râm với lớp vải lót mềm mại, một dây móc khóa ở bên hông và các ngăn đựng bên trong giúp sắp xếp các món đồ thiết yếu khác.</p>\n            </div>\n          </section>\n          <script>\n            window.featuresRun = function () {\n              $.getScript(\"V1/lib/jquery-3.4.1.min.js\", function () {});\n              $.getScript(\"V1/lib/scrollreveal.min.js\", function () {});\n              $.getScript(\"V1/lib/jquery.mobile.custom.min.js\", function () {});\n              $.getScript(\"V1/js/main.js\", function () {});\n            };\n          </script>\n\n          <script\n            type=\"text/javascript\"\n            src=\"https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/lib/jquery-3.4.1.min.js\"\n          ></script>\n          <script\n            type=\"text/javascript\"\n            src=\"https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/lib/scrollreveal.min.js\"\n          ></script>\n          <script\n            type=\"text/javascript\"\n            src=\"https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/lib/jquery.mobile.custom.min.js\"\n          ></script>\n          <script\n            type=\"text/javascript\"\n            src=\"https://dlcdnwebimgs.asus.com/files/media/1E9F5773-4D31-43D0-A942-7E2EC7829976/V1/js/main.js\"\n          ></script>\n        </div>\n        <!-- end of <div class=\"charger-wrapper\"> -->\n      </div>\n    </section>\n  </div>\n  <!-- end of <div class=\"inner overview-wrapper\"> -->\n</div> </div></div></div></div></div> <div class=\"awardClone Product__specialOverviewAward__St9uq\"><div class=\"ProductOverviewAwards__