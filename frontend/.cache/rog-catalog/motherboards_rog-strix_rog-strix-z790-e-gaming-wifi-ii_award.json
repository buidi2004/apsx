tabpanel-media\" id=\"All\" class=\"awardItem ProductAwards__awardTab__yaTHJ ProductAwards__active__9TvSy\">\n          All\n      </li> <li aria-label=\"ROG STRIX Z790-E GAMING WIFI II Giải thưởng\" role=\"tab\" tabindex=\"-1\" aria-controls=\"tabpanel-awards\" id=\"Giải_thưởng\" class=\"awardItem ProductAwards__awardTab__yaTHJ\" style=\"display:;\">\n          Giải thưởng\n      </li> <li aria-label=\"ROG STRIX Z790-E GAMING WIFI II Video review\" role=\"tab\" tabindex=\"-1\" aria-controls=\"tabpanel-video\" id=\"Video_review\" class=\"awardItem ProductAwards__awardTab__yaTHJ\" style=\"display:;\">\n          Video review\n      </li> <li aria-label=\"ROG STRIX Z790-E GAMING WIFI II Media review\" role=\"tab\" tabindex=\"-1\" aria-controls=\"tabpanel-media\" id=\"Media_review\" class=\"awardItem ProductAwards__awardTab__yaTHJ\" style=\"display:;\">\n          Media review\n      </li></ul></div> <div id=\"tabpanel-awards\" role=\"tabpanel\" aria-labelledby=\"Giải_thưởng\"><div class=\"ProductAward__productAwardPagePadding__dSaZj\"><div class=\"ProductAward__awardTitle__GUset\"><h2 class=\"pageAward vnRogFont ProductAward__vnRogFontSize__5eSiT\">\n        Giải thưởng \n      </h2> <span>(21)</span></div> <div class=\"ProductAward__mobileAwardContent__LNDCh\"><ul class=\"ProductAward__rewardContainer__sHbkR\" style=\"width:100%;\"><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1340/202405130838204900341.png\" alt=\"\" aria-label=\"RECOMMENDED AWARD\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      Think Computers\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>RECOMMENDED AWARD</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      The ASUS ROG Strix Z790-E Gaming WiFi II Motherboard offers unparalleled storage flexibility with multiple M.2 slots featuring tool-free installation, along with convenient features like AI overclocking and a PCIe Slot Q-release button, all at a fair price of $479.99, earning it a perfect 10 out of 10 score and our Recommended Award.\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>USA</span> <span>04/29/2024</span></div> <a aria-label=\"ROG STRIX Z790-E GAMING WIFI II Media review Award of RECOMMENDED AWARD\" tabindex=\"0\" href=\"https://thinkcomputers.org/asus-rog-strix-z790-e-gaming-wifi-ii-review/10/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1339/202012092308140870565.png\" alt=\"\" aria-label=\"Extreme Performance \" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      Eteknix\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>Extreme Performance </p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      &quot;If you’re looking for a great gaming motherboard, that packs an impressive punch for computational heavy workloads such as game development and video rendering, this is one of the best on the market&quot;\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>UNITED KINGDOM</span> <span>01/02/2024</span></div> <a aria-label=\"ROG STRIX Z790-E GAMING WIFI II Media review Award of Extreme Performance \" tabindex=\"0\" href=\"https://www.eteknix.com/asus-rog-strix-z790-e-gaming-wifi-review/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1265/202401200012580710079.png\" alt=\"\" aria-label=\"Gamezoom 95%\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      gamezoom.net\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>Gamezoom 95%</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      With the ROG Strix Z790-E Gaming WIFI II, manufacturer ASUS delivers a true flagship motherboard for high-end Intel gamers.\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>GERMANY</span> <span>01/15/2024</span></div> <a aria-label=\"ROG STRIX Z790-E GAMING WIFI II Media review Award of Gamezoom 95%\" tabindex=\"0\" href=\"https://www.gamezoom.net/artikel/ASUS_ROG_Strix_Z790_E_Gaming_WIFI_II_Test_Review-54009\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1265/202401051703587850019.png\" alt=\"\" aria-label=\"Hardwareinside top class recommendation\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      hardwareinside.de\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>Hardwareinside top class recommendation</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      The ASUS ROG STRIX Z790-E GAMING WIFI II leaves nothing to be desired, no matter which aspect of the motherboard you look at.\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>GERMANY</span> <span>01/03/2024</span></div> <a aria-label=\"ROG STRIX Z790-E GAMING WIFI II Media review Award of Hardwareinside top class recommendation\" tabindex=\"0\" href=\"https://www.hardwareinside.de/asus-rog-strix-z790-e-gaming-wifi-ii-im-test-80444/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1263/202002172051514190001.png\" alt=\"\" aria-label=\"Silver Award\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      Hardware Cooking\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>Silver Award</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      In terms of connectivity, given the high-end positioning of the motherboard, we're in for a real treat. There are eleven 10 Gb/s USB ports, including one Type-C port. But that's not all, as the rear connector also offers a Type-C port with a speed of 20 Gb/s.\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>FRANCE</span> <span>01/06/2024</span></div> <a aria-label=\"ROG STRIX Z790-E GAMING WIFI II Media review Award of Silver Award\" tabindex=\"0\" href=\"https://www.hardwarecooking.fr/test-asus-rog-strix-z790-e-gaming-wifi-ii/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1263/202303081628288460637.png\" alt=\"\" aria-label=\"9.5 out of 10\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      CharlesTech\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>9.5 out of 10</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      The ROG Strix Z790-E Gaming WiFi II is a very good motherboard, which looks even better [...]. A success, at a high price, but clearly worth it if you need high performance and flexibility in terms of overclocking.\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>FRANCE</span> <span>01/04/2024</span></div> <a aria-label=\"ROG STRIX Z790-E GAMING WIFI II Media review Award of 9.5 out of 10\" tabindex=\"0\" href=\"https://charlestech.fr/test-asus-rog-strix-z790-e-gaming-wifi-ii/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1263/202203072144527310010.png\" alt=\"\" aria-label=\"9 out of 10\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      TomsHardware\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>9 out of 10</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      A mountain of features combined with quality components, sprinkled with intelligent algorithms and welcomed new features like WiFi 7: that's more or less how you could sum up this ROG Strix Z790-E Gaming WiFi II from ASUS.\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>FRANCE</span> <span>11/20/2023</span></div> <a aria-label=\"ROG STRIX Z790-E GAMING WIFI II Media review Award of 9 out of 10\" tabindex=\"0\" href=\"https://www.tomshardware.fr/test-asus-rog-strix-z790-e-gaming-wifi-ii-carte-mere-lga1700-intel-core-raptor-lake-refresh/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1263/202009142057259220498.PNG\" alt=\"\" aria-label=\"9 out of 10\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      Clubic\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>9 out of 10</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      Overclocking enthusiasts can rely on support for DDR5-8000+, while the rear connectivity features a total of 10 USB-A 3.2 Gen 2 (10 Gbps) ports. In other words, you're all set.\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>FRANCE</span> <span>10/20/2023</span></div> <a aria-label=\"ROG STRIX Z790-E GAMING WIFI II Media review Award of 9 out of 10\" tabindex=\"0\" href=\"https://www.clubic.com/test-produit-506032-test-asus-rog-strix-z790-e-gaming-wifi-ii-le-nec-plus-ultra-de-la-carte-mere-intel-progresse-encore.html\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li></ul></div> <!----></div> <div class=\"ProductAward__rewardMoreButton__NCAU7\"><div class=\"seeAllButton__seeAllBut