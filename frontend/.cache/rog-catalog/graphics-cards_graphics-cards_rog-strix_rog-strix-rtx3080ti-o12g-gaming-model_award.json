www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1332/202204082241038060702.png\" alt=\"\" aria-label=\"Best Graphics Card - Editor's Choice\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      HardwareZone.com\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>Best Graphics Card - Editor's Choice</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      The ROG Strix GeForce RTX 3080 Ti Gaming OC offers far better bang for your buck. The entire card screams premium, with stunning customisable RGB LEDs, an incredibly beefy heatsink, and a rigid backplate to reinforce its structure. And with killer looks, stratospheric performance, and solid thermals, ASUS has made yet another winner.\n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>SINGAPORE</span> <span>05/31/2022</span></div> <a aria-label=\"ROG-STRIX-RTX3080TI-O12G-GAMING Media review Award of Best Graphics Card - Editor's Choice\" tabindex=\"0\" href=\"https://www.hardwarezone.com.sg/tech-news-hwz-tech-awards-2022-honours-64-best-tech-brands-and-products/editor-s-choice-winners-2022\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1225/202105071449568210668.png\" alt=\"\" aria-label=\"AUSGAMERS ESSENTIAL\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      AusGamers\n    </p> <div class=\"ProductAwardsItem__awardName__jAstt\"><p>AUSGAMERS ESSENTIAL</p></div> <p class=\"ProductAwardsItem__awardDescription__KhisN\">\n      The ASUS ROG STRIX GeForce RTX 3080 Ti OC is without a doubt a high-end premium GPU, from its built quality to overall size, cooling, and features. \n    </p></div> <div class=\"ProductAwardsItem__awardItemBottom__4mvlW\"><div class=\"ProductAwardsItem__awardItemBottomLeft__4xC-s\"><span>AUSTRALIA</span> <span>07/09/2021</span></div> <a aria-label=\"ROG-STRIX-RTX3080TI-O12G-GAMING Media review Award of AUSGAMERS ESSENTIAL\" tabindex=\"0\" href=\"https://www.ausgamers.com/reviews/read.php/3635897\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"ProductAwardsItem__awardItemMoreLink__pG7gP\"><span>Thêm</span> <svg xmlns=\"http://www.w3.org/2000/svg\" data-name=\"圖層 1\" viewBox=\"0 0 32 32\" aria-hidden=\"true\" svg-inline alt=\"right\" role=\"presentation\" focusable=\"false\"><path d=\"M23.07 13.77L9.06 0v6.7l9.18 8.94-9.18 9.66V32l14.01-14.49 1.87-1.87-1.87-1.87z\"></path></svg></a></div></li><li class=\"ProductAwardsItem__rewardItem__qQut7\"><div class=\"ProductAwardsItem__awardItemTop__AQaLj\"><div class=\"ProductAwardsItem__rewardImageBox__pTW-S\"><img  src=\"https://www.asus.com/media/images/award_logo/1225/202006121338494220589.png\" alt=\"\" aria-label=\"TweakTown Editor's Choice\" class=\"awardImage\"> <!----></div> <p class=\"ProductAwardsItem__awardMediaName__yE0u9\">\n      TweakTown\n    </p> <div class=\"ProductAwardsItem__award