ion overview_Special\" style=\"width: 100%;\">\n\n            <div class=\"ASUS-importer\">\n\n                <link rel=\"stylesheet\" type=\"text/css\" href=\"https://dlcdnwebimgs.asus.com/files/media/B1792FF5-3F8B-47BB-8266-E9DD3A472937/v1/css/index.css\">\n                <link rel=\"preload\" href=\"https://dlcdnwebimgs.asus.com/files/media/B1792FF5-3F8B-47BB-8266-E9DD3A472937/v1/font/Trade-Gothic-LT-Bold.woff2\" as=\"font\" crossorigin=\"\">\n            </div>\n\n            <div id=\"ASUS-features\">\n                <!-- 外層-->\n                <div class=\"outer-view\">\n                    <section class=\"section__1 section__base section__kv\" id=\"section1\">\n                        <div class=\"row\">\n                            <div class=\"col\">\n                                <figure class=\"img img__kv lazyLoad\" aria-label=\"An ROG Ally inside the Ally Travel Case, with just the top corner peeking out, on a white background.\" role=\"figure\">\n                                </figure>\n                            </div>\n                            <div class=\"col\">\n                                <div class=\"content-frame\" id=\"undefined__content\">\n                                    <div class=\"img img__kv__logo text-animate\"></div>\n                                    <div class=\"wd-content large-text-center medium-text-center small-text-center text-animate\">\n                                        <div class=\"content-info\">Giữ an toàn cho máy chơi game cầm tay ROG Ally trong khi di chuyển với bao đựng ROG Ally Travel Case.<br />Nhờ chất liệu mềm mại và lớp lót nỉ bên trong, ROG Ally sẽ được bảo vệ an toàn trong mọi hoàn cảnh.</div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                    <section class=\"section__2 section__base section__s2\" id=\"section2\">\n                        <div class=\"row\">\n                            <div class=\"col\">\n                                <figure class=\"img img__02__design1 lazyLoad\" aria-label=\"An ROG Ally, half inside of the Ally Travel Case, on a white background.\" role=\"figure\">\n                                </figure>\n                            </div>\n                            <div class=\"col\">\n                                <div class=\"content-frame\" id=\"s2__content\">\n                                    <div class=\"wd-content large-text-center medium-text-center small-text-center text-animate\">\n                                        <div class=\"img icon_slogan lazyLoad\" id=\"s2__icon\"></div>\n                                        <div style=\"font-family:Arial !important;\" class=\"content-slogan\" data-text=\"All-weather protection\">Bảo vệ khỏi mọi kiểu thời tiết</div>\n                                        <div class=\"content-info\">Vải PU chống nước bảo vệ máy chơi game cầm tay ROG Ally khỏi tai nạn đổ nước và hiện tượng thời tiết khắc nghiệt, đồng thời toàn bộ bao đựng được giữ an toàn nhờ khóa kéo YKK cao cấp với logo ROG. Lớp lót nỉ bên trong bảo vệ màn hình chống trầy xước.</div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                    <section class=\"section__3 section__base section__s3\" id=\"section3\">\n                        <div class=\"row\">\n                            <div class=\"col\">\n                                <figure class=\"img img__03__standTall lazyLoad\" aria-label=\"An ROG Ally in stand mode inside of a half open Ally Travel Case, with both on a blue table.\" role=\"figure\">\n                                </figure>\n                            </div>\n                            <div class=\"col\">\n                                <div class=\"content-frame\" id=\"s3__content\">\n                                    <div class=\"wd-content large-text-center medium-text-center small-text-center text-animate\">\n                                        <div class=\"img icon_slogan lazyLoad\" id=\"s3__icon\"></div>\n                                        <div style=\"font-family:Arial !important;\" class=\"content-slogan\" data-text=\"Stand tall\">Đứng thẳng</div>\n                                        <div class=\"content-info\">Khi bạn cần tác chiến trong game, chiếc bao đựng có thể biến thành giá đỡ di động. Với nhiều ngăn giữa gập lại, bao đựng ROG Ally Travel Case sẽ giúp bạn hành động thật chính xác.</div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                    <section class=\"section__4 section__base section__s4\" id=\"section4\">\n                        <div class=\"row\">\n                            <div class=\"col\">\n                                <figure class=\"img img__04__secureStorage lazyLoad\" aria-label=\"The ROG Ally Travel Case, empty and open fully, with emphasis on the card and MicroSD card storage.\" role=\"figure\">\n                                </figure>\n                            </div>\n                            <div class=\"col\">\n                                <div class=\"content-frame\" id=\"s4__content\">\n                                    <div class=\"wd-content large-text-center medium-text-center small-text-center text-animate\">\n                                        <div style=\"font-family:Arial !important;\" class=\"content-title\" data-text=\"Secure storage\">Kho lưu trữ bảo mật</div>\n                                        <div class=\"img icon_title\"></div>\n                                        <div class=\"content-info\">Bao đựng ROG Ally Travel Case có ngăn bảo mật cho cả thẻ MicroSD lẫn các loại thẻ tín dụng.</div>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </section>\n                </div>\n            </div>\n        </div>\n        <script src=\"https://dlcdnwebimgs.asus.com/files/media/0EE47A6A-E964-48A7-9332-8C5FD982A196/v1/js/jquery-3.6.0.min.js\"></script>\n        <script type=\"text/javascript\" >\n            window.featuresRun = function(){\n\n                $.getScript( \"https://dlcdnwebimgs.asus.com/files/media/B1792FF5-3F8B-47BB-8266-E9DD3A472937/v1/js/index.js\", function(){} );\n            }\n            // featuresRun();\n        </script>\n\n    </section>\n\n</div></div></div> <div class=\"awardClone Product__specialOverviewAward__St9uq\"><div class=\"ProductOverviewAwards__productOverviewAwards__CtD9H\"><div class=\"ProductOverviewAwardsContent__productAwardContainer__JF3vK ProductOverviewAwardsContent__black__p4RLG\"><h2 class=\"awardTitle vnRogFont ProductOverviewAwardsContent__vnRogFontSize__G4nLE\">Giải thưởng</h2> <div class=\"ProductOverviewAwardsContent__productAwardPage__VsRsr\"><button type=\"button\" aria-label=\"Previous slide\" class=\"ProductOverviewAwardsContent__leftButton__Be29v\" style=\"display:none;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"72\" height=\"72\" viewBox=\"0 0 72 72\" svg-inline alt=\"slide prev\" role=\"presentation\" focusable=\"false\"><defs><clipPath id=\"a\"><path data-name=\"矩形 11055\" transform=\"translate(-11812 4633)\" d=\"M0 0h72v72H0z\" fill=\"none\"></path></clipPath></defs><g data-name=\"icon-arrow-big\" transform=\"translate(11812 -4633)\" clip-path=\"url(#a)\"><path data-name=\"联合 614\" d=\"M-11787 4697l18-28h4l-18 28zm18-28l-18-28h4l18 28z\" fill=\"#fff\"></path></g></svg></button> <button type=\"button\" aria-label=\"Next Slide\" class=\"ProductOverviewAwardsContent__rightButton__NDVSj\" style=\"display:none;\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"72\" height=\"