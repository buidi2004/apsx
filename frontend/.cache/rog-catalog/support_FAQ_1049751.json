+[a-zA-Z]{2,}))$/;\r\n                            var isEmail = emailValidations.test(email);\r\n\r\n                            if (isEmail) {\r\n                                $.get(_supportDomain + 'support/webapi/faq/SetFaqByMail?website=' + _website + '&kb_no=' + siteConfig.KBNo + '&address=' + email).then(function (response) {\r\n                                    if (response.Status === \"SUCCESS\") {                                    \r\n                                        ToClose(\"MailPopup\");\r\n                                    }\r\n                                    document.getElementById(\"inputEmail\").value = '';\r\n                                    $('#errorMsg').css('display', 'none');\r\n                                });\r\n                            } else {\r\n                                $('#errorMsg').css('display', 'block');\r\n                            }\r\n                        }\r\n                 </script>\r\n\r\n                 \r\n\r\n                 \r\n\r\n                <div class=\"page-content content-toomuch\">\r\n\r\n                \r\n                   \r\n                <div id=\"faq-content\" class=\"model-title\">    \r\n                    <div class=\"tag-container\">\r\n                       <span class=\"tag-title\">Sản phẩm</span>\r\n                       <span class=\"tag\">FA507NJ, FA507NU, FA507NV, FA507XI, FA507XJ, FA507XU, FA507XV, FA617NS, FA707NJ, FA707NU, FA707NV, FA707XI, FA707XJ, FA707XU, FA707XV, FX507ZU, FX507ZV, FX707ZU, FX707ZV, G614JJ, G614JU, G614JV, G614JZ, G634JY, G634JZ, G713PI, G713PU, G713PV, G733PY, G733PYV, G733PZ, G733PZV, G814JI, G814JU, G814JV, G814JZ, G834JY, G834JZ, GA402NI, GA402NJ, GA402NU, GA402NV, GA402XI, GA402XU, GA402XV, GA402XY, GA402XZ, GU603VI, GU603VU, GU603VV, GU603ZI, GU603ZU, GU603ZV, GU604VI, GU604VY, GU604VZ, GV302XA, GV302XI, GV302XU, GV302XV, GV601VI, GV601VU, GV601VV, GX650PY, GX650PZ, GZ301VF, GZ301VI, GZ301VIC, GZ301VU, GZ301VV</span>\r\n                    </div>\r\n                    <button\r\n                       class=\"tag-button\"\r\n                       style=\"display: inline-block;\"\r\n                       onclick=\"$(this).hide(); $('.tag-container').addClass('show-more'); $(this).next().show();\">More</button>\r\n                    <button\r\n                       class=\"tag-button\"\r\n                       style=\"display: none;\"\r\n                       onclick=\"$(this).hide(); $('.tag-container').removeClass('show-more'); $(this).prev().show();\">Hide</button>\r\n                </div>                    \r\n                \r\n                \r\n\r\n                <div id=\"faq-content\" class=\"main-content\">\r\n                    <div>\r\n                        <p>[Gaming NB] 2023 Gaming New Series Hướng dẫn thông báo nâng cấp phần cứng .</p>\r\n                        <p>Để tr&aacute;nh t&igrave;nh trạng Main-Board bị hỏng do nguồn pin của laptop kh&ocirc;ng được ngắt khi người d&ugrave;ng cố gắng n&acirc;ng cấp bộ nhớ laptop/SSD, c&aacute;c mẫu laptop ASUS 2023 Gaming series mới c&oacute; thiết kế bảo vệ mới, <strong>Cảm biến &aacute;nh s&aacute;ng xung quanh (ALS)</strong>, khi người d&ugrave;ng th&aacute;o nắp dưới khỏi m&aacute;y t&iacute;nh x&aacute;ch tay , tự động ngắt -tắt nguồn hệ thống&nbsp;.</p>\n\n<p>Do đ&oacute;, khi bạn chuẩn bị thay thế hoặc n&acirc;ng cấp linh kiện m&aacute;y t&iacute;nh x&aacute;ch tay, vui l&ograve;ng tắt nguồn m&aacute;y t&iacute;nh x&aacute;ch tay, sau khi thay thế xong, vui l&ograve;ng lắp r&aacute;p nắp dưới đ&uacute;ng c&aacute;ch, sau đ&oacute; cắm bộ đổi nguồn AC v&agrave;o m&aacute;y t&iacute;nh x&aacute;ch tay để sạc để tắt nguồn hệ thống sự bảo vệ.</p>\n\n<p><img  alt=\"\" src=\"https://kmpic.asus.com/images/2023/02/08/f1fe988f-ae48-4bdd-b1c0-bd318fdd36e6.png\" style=\"width: 800px; height: 320px;\" /></p>\n\r\n                    </div>\r\n                </div>\r\n\r\n                </div>\r\n                \r\n                \r\n                \r\n                \r\n                <div class=\"feedback-block\">\r\n                    <h3 class=\"title\">Thông tin này có hữu ích không?</h3>\r\n                    <a class=\"af-sp-btn btn-fb-yes\" onclick=\"$('#FBPopup').show();saveFeedback('Y')\" href=\"javascript:;\">Yes</a>\r\n                    <a class=\"af-sp-btn btn-fb-no\"  onclick=\"$('#FBPopup').show();saveFeedback('N')\" href=\"javascript:;\">No</a>\r\n                </div>\r\n\r\n                \r\n                <div id=\"FBPopup\" hidden>\r\n                    <div class=\"modal-mask modal-FB-yes02\">\r\n                        <div class=\"modal-wrapper\">\r\n                        <div class=\"modal-container\">\r\n                            <a class=\"modal-default-button\" onclick=\"ToClose('FBPopup')\" href=\"javascript:;\"></a>\r\n                            <div class=\"modal-body\">\r\n                             <p class=\"desp\">Chúng tôi có thể làm gì để cải thiện bài viết này?</p>\r\n                              <input placeholder=\"(tùy chọn)\" id=\"feedback\">\r\n                              <a class=\"af-sp-btn btn-submit\" onclick=\"saveFeedback('')\" href=\"javascript:;\"> Gửi đi</a>\r\n                              <a class=\"af-sp-btn af-sp-white-btn btn-skip\" onclick=\"saveFeedback('')\" href=\"javascript:;\"> Bỏ qua</a>\r\n                            </div>\r\n                        </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div id=\"FBPopupClose\" style=\"display:none\">\r\n                    <div class=\"modal-mask modal-FB-yes03\">\r\n                        <div class=\"modal-wrapper\">\r\n                            <div class=\"modal-container\">\r\n                                <a class=\"modal-default-button\" onclick=\"ToClose('FBPopupClose')\" href=\"javascript:;\"></a>\r\n                                <div class=\"modal-body\">\r\n                                    <p id=\"feedbackCompleted\" class=\"desp\"></p>\r\n                                    <a class=\"af-sp-btn btn-close\" onclick=\"ToClose('FBPopupClose')\" href=\"javascript:;\">Đóng</a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                \r\n\r\n                <script>\r\n                    function saveFeedback(sid) {\r\n                        var answer = \"\";\r\n                        var formData = new FormData();\r\n\r\n                        if (sid == '') {\r\n                            formData.append(\"Answers_542\", answer);\r\n                            formData.append(\"Answers_543\", document.getElementById(\"feedback\").value);\r\n\r\n                            var offset = +8;\r\n                            var now = new Date(new Date().getTime() + offset * 3600 * 1000).toUTCString();\r\n                            var monthArray = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];\r\n                            var date = now.split(',')[1].split(' ');\r\n                            var year = date[3];\r\n                            var month = monthArray.indexOf(date[2]) + 1;\r\n                            var day = date[1];\r\n                            var lang = navigator.language || navigator.userLanguage;\r\n                                                                                                                         \r\n                            formData.append(\"Id\", \"48\");\r\n                            formData.append(\"verification\", \"95b9ca36d993bcccfff50c0d520cb0f5fafc0f0f5b1eb6ecf1f913055307aab8adf91407060ab3f7a8a9430c4f0ab1b8fbe0185d035babe3f8f5435a035ab2edaffb423f623e86da\");\r\n                            formData.append(\"lang\", lang);\r\n                            formData.append(\"Answers_544\", siteConfig.KBNo);\r\n                            formData.append(\"Answers_545\", siteConfig.website);\r\n                            formData.append(\"Answers_547\", year + \"/\" + month + \"/\" + day);\r\n                            formData.append(\"Answers_terms_of_use\", \"1\");\r\n                            formData.append(\"Answers_privacy_policy\", \"1\");\r\n\r\n                            if (!siteConfig.website == 'cn') {\r\n \r\n                                $.ajax({\r\n                                    type: 'get',\r\n                                    url: \"https://rog.asus.com/geo/\",\r\n                                    success: function (data, textStatus, xhr) {\r\n                                        var akamia_country_code = xhr.getResponseHeader('website_code');\r\n                                        var akamia_region_code = xhr.getResponseHeader('area_code');\r\n                                        //console.log(akamia_country_code + \"--\" + akamia_region_code);\r\n                                        formData.append(\"Answers_546\", akamia_country_code);\r\n                                                                            postFeedBack(formData);\r\n                                                                            document.getElementById(\"feedback\").value = \"\";\r\n                                                                        },\r\n                                                                        error: function (xhr, ajaxOptions, thrownError) {\r\n                                                                            console.log(xhr.status + \" --------------------------- \" + thrownError);\r\n                                                                        }\r\n                                                                    });\r\n                            } else {\r\n                                postFeedBack(formData);\r\n                            }\r\n                        } else {\r\n                            if (sid == 'Y') {\r\n                                answer = 4060\r\n                            }\r\n                            else {\r\n                                answer = 4061\r\n                            }\r\n                        }\r\n\r\n                    }\r\n\r\n                    postFeedBack: function postFeedBack(formData) {\r\n                        $.ajax({\r\n                            type: \"post\",\r\n                            url: _surveryDomain + \"surveys.asmx/sentSurvey\",\r\n                            data: formData,\r\n                            processData: false,\r\n                            contentType: false,\r\n                            success: function (response) {\r\n                                $('#feedbackCompleted').html(response.data.message);\r\n                                $('#FBPopup').css('display', 'none');\r\n                                $('#FBPopupClose').css('display', 'block');\r\n                            }\r\n                        })\r\n                    }\r\n\r\n                    function ToClose(id) {\r\n                        $('#' + id).css('display', 'none');\r\n                    }\r\n\r\n                </script>\r\n                <div class=\"notice-block\">\r\n                    <ul><li> Thông tin bên trên có thể được trích dẫn một phần hoặc toàn bộ từ các trang web hoặc nguồn bên ngoài. Vui lòng tham khảo thông tin dựa trên nguồn mà chúng tôi đã lưu ý. Vui lòng liên hệ trực tiếp hoặc hỏi nguồn nếu có thêm bất kỳ câu hỏi nào và lưu ý rằng ASUS không liên quan và không chịu trách nhiệm về nội dung / dịch vụ </ li> <li> Thông ti</ul>\r\n                </div>\r\n            </div>\r\n        </section>\r\n        \r\n        <section class=\"af-sp-container-m af-sp-m-breadcrumbs\"> \r\n            <div class=\"main-inner\">\r\n                <a href=\"https://rog.asus.com/vn/\">ASUS</a>\r\n                <a hr